/* ===== OIM v9.x - diagnostyka zablokowanego DBQueue (Generate* / Trigger tasks) ===== */

-- 1) Ogolny stan systemu (to samo co widzi Manager/Designer w "System status")
SELECT * FROM QBMVSystemState;

-- 2) Flagi bazy, ktore zatrzymuja DBQueue
SELECT IsDBSchedulerDisabled,      -- 1 = DBQueue processing disabled
       IsJobServiceDisabled,
       SingleUserProcess,          -- >0 = single user mode (np. po przerwanym compile/migracji)
       UpdatePhase,                -- >0 = "System update running"
       UID_CutOffTask              -- NOT NULL = procesor stoi na "cut-off" (czeka na kompilator)
FROM DialogDatabase WHERE IsMainDatabase = 1;

-- 3) Czy Database Agent Service jest podpiety do bazy
SELECT session_id, program_name, host_name, login_name, login_time, status
FROM sys.dm_exec_sessions
WHERE database_id = DB_ID() AND (program_name = 'OneIM_DatabaseAgent' OR program_name LIKE 'OneIM_Bootstrap%');

-- 4) Kolejka wg poziomow (PathLength = "Sort order" w Managerze)
SELECT m.UID_Task, m.PathLength, m.CountInDBQueue, m.CountProcessing, m.CountResetted
FROM QBMDBQueueTaskMetric m
WHERE m.CountInDBQueue + m.CountProcessing > 0
ORDER BY m.PathLength;

-- 5) Wpisy "zawieszone" - wyjete do slotu (Generation = -1), a slot juz nie istnieje
SELECT q.UID_Task, q.Generation, COUNT(*) cnt
FROM DialogDBQueue q GROUP BY q.UID_Task, q.Generation ORDER BY q.UID_Task;
SELECT cu.SlotNumber, cu.UID_Task, cu.StartedAt, COUNT(*) cnt
FROM QBMDBQueueCurrent cu GROUP BY cu.SlotNumber, cu.UID_Task, cu.StartedAt ORDER BY cu.StartedAt;

-- 6) Ostatnie bledy DBQueue / kompilacji w journalu
SELECT TOP 50 MessageDate, MessageType, ApplicationName, HostName, MessageString
FROM DialogJournal
WHERE MessageType IN ('E','W') AND MessageDate > DATEADD(day,-10,GETUTCDATE())
ORDER BY MessageDate DESC;

