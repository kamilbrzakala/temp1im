-- the job at the front of the line
SELECT TOP 3 q.UID_Job, q.StartAt,
       SQLStmt = (SELECT TOP 1 x.ParameterValue FROM dbo.QBM_FCVJobParameterToList(q.ParamIN) x WHERE x.ParameterName = 'SQLStmt')
FROM JobQueue q
WHERE q.Queue = 'QBM_PWorkMaintenance' AND q.IsRootJob = 1 AND q.Ready2EXE = 'TRUE'
ORDER BY q.StartAt;

-- run the worker once and read the hidden error
DECLARE @t datetime2 = SYSDATETIME();
BEGIN TRY
    EXEC QBM_PWorkMaintenance;
    PRINT 'Finished OK';
END TRY
BEGIN CATCH
    SELECT dbo.QBM_FGISessionErrorForLog() AS RealError;
END CATCH
SELECT DATEDIFF(second, @t, SYSDATETIME()) AS Seconds,
       (SELECT COUNT(*) FROM JobQueue WHERE Queue = 'QBM_PWorkMaintenance' AND Ready2EXE = 'TRUE') AS Waiting;
