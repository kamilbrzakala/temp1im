/* =====================================================================
   OIM v9.x  -  JobQueue "Execute SQL" jobs in queue QBM_PWorkMaintenance
   (QBM_PIndexRebuild / QBM_PSetRowLockOnly / statistics ...)

   How they work:
   - Created by QBM_PJobCreate_Mnt, called from the maintenance tasks
     QBM_ZIndexRebuild, QBM_ZSetRowLockOnly_2, QBM_ZUpdateStatistics,
     QBM_ZTableStatistics, QBM_ZColumnCheckBlobExternal, QBM_ZTableRevisionFill.
   - NO Job Service executes them. "QBM_PWorkMaintenance" is a pseudo-queue
     (blocked for real QBMServer.QueueName). The Database Agent calls
     proc QBM_PWorkMaintenance, which:
       * stops at once if DialogDatabase.IsDBSchedulerDisabled = 1 or SingleUserProcess > 0
       * takes TOP 500 Ready2EXE='TRUE' jobs ORDER BY StartAt
       * runs them one by one for max 59 s, with LOCK_TIMEOUT 1000 ms
       * on success sets Ready2EXE='DELETE' (QBM_PWorkJobQueueDelete removes it)
       * on ANY non-deadlock error RAISES and aborts the whole run
         -> the same failing job is first again next time = head-of-line block.
   Run section by section. Sections 1-6 only read.
   ===================================================================== */

-- 1. Volume: what is waiting, per statement type
SELECT  Stmt = LEFT(p.SQLStmt, CHARINDEX(' ', p.SQLStmt + ' ', 6)) ,
        q.Ready2EXE, Cnt = COUNT(*),
        OldestStartAt = MIN(q.StartAt), NewestIns = MAX(q.XDateInserted),
        WithErr = SUM(CASE WHEN ISNULL(q.ErrorMessages,'') <> '' THEN 1 ELSE 0 END)
FROM JobQueue q
CROSS APPLY (SELECT SQLStmt = (SELECT TOP 1 x.ParameterValue FROM dbo.QBM_FCVJobParameterToList(q.ParamIN) x
                               WHERE x.ParameterName = 'SQLStmt')) p
WHERE q.Queue = 'QBM_PWorkMaintenance'
GROUP BY LEFT(p.SQLStmt, CHARINDEX(' ', p.SQLStmt + ' ', 6)), q.Ready2EXE
ORDER BY Cnt DESC;

-- 2. The head of the line = the job the agent tries first every run.
--    If this one never disappears, it is the blocker. Note its SQLStmt.
SELECT TOP 10 q.UID_Job, q.StartAt, q.XDateInserted, q.Ready2EXE, q.Retries, q.ErrorMessages,
       SQLStmt = (SELECT TOP 1 x.ParameterValue FROM dbo.QBM_FCVJobParameterToList(q.ParamIN) x WHERE x.ParameterName = 'SQLStmt')
FROM JobQueue q
WHERE q.Queue = 'QBM_PWorkMaintenance' AND q.IsRootJob = 1 AND q.Ready2EXE = 'TRUE'
ORDER BY q.StartAt;

-- 3. Is the agent working on it at all? ServerProcess = spid while running, 0 when idle.
SELECT a.Ident_QBMDBQueueAgent, a.ServerProcess,
       s.program_name, s.status, s.last_request_start_time, r.command, r.wait_type,
       r.wait_time, r.blocking_session_id, r.percent_complete
FROM QBMDBQueueAgent a
LEFT JOIN sys.dm_exec_sessions s ON s.session_id = a.ServerProcess AND a.ServerProcess > 0
LEFT JOIN sys.dm_exec_requests r ON r.session_id = a.ServerProcess AND a.ServerProcess > 0;

-- Database Agent sessions in general
SELECT session_id, program_name, host_name, status, login_time, last_request_start_time
FROM sys.dm_exec_sessions WHERE program_name LIKE '%DatabaseAgent%' OR program_name LIKE '%DBQueue%';

-- 4. Global switches. Any of these true -> QBM_PWorkMaintenance does nothing.
SELECT IsDBSchedulerDisabled, SingleUserProcess, UpdatePhase, UID_CutOffTask
FROM DialogDatabase WHERE IsMainDatabase = 1;
SELECT * FROM QBMVSystemState;   -- e.g. "Database waiting for compilation"

-- 5. Errors from the agent (MessageDate is UTC)
SELECT TOP 50 MessageDate, MessageType, LEFT(MessageString, 2000) AS Msg
FROM DialogJournal
WHERE MessageDate > DATEADD(day, -3, GETUTCDATE())
  AND (MessageString LIKE '%PWorkMaintenance%' OR MessageString LIKE '%IndexRebuild%'
    OR MessageString LIKE '%SetRowLockOnly%' OR MessageString LIKE '%Lock request time out%'
    OR MessageString LIKE '%1222%')
ORDER BY MessageDate DESC;

-- 6. Who is holding locks on the table of the head job (replace UNSRootB)
SELECT l.request_session_id, s.program_name, s.host_name, l.request_mode, l.request_status
FROM sys.dm_tran_locks l
JOIN sys.dm_exec_sessions s ON s.session_id = l.request_session_id
WHERE l.resource_type = 'OBJECT' AND l.resource_associated_entity_id = OBJECT_ID('UNSRootB');

