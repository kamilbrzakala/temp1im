-- 1) Which table do the references point to?
SELECT SUBSTRING(s.ObjectKeyOfAssignedOrg,
                 CHARINDEX('<T>', s.ObjectKeyOfAssignedOrg) + 3,
                 CHARINDEX('</T>', s.ObjectKeyOfAssignedOrg) - CHARINDEX('<T>', s.ObjectKeyOfAssignedOrg) - 3) AS TargetTable,
       b.Ident_Org, b.FullPath, b.UID_OrgRoot, COUNT(*) AS Steps
FROM PWODecisionStep s
LEFT JOIN BaseTree b ON b.XObjectKey = s.ObjectKeyOfAssignedOrg
WHERE ISNULL(s.ObjectKeyOfAssignedOrg, '') <> ''
GROUP BY s.ObjectKeyOfAssignedOrg, b.Ident_Org, b.FullPath, b.UID_OrgRoot
ORDER BY Steps DESC;

-- 2) Fallback name search across all role types
SELECT Ident_Org, FullPath, UID_OrgRoot, XObjectKey
FROM BaseTree
WHERE Ident_Org LIKE '%Escalation Approvers%'
   OR Ident_Org LIKE '%Attestation Remediation%'
   OR Ident_Org LIKE '%Employee Administrator%'
   OR Ident_Org LIKE '%Non Person Approvers%';
