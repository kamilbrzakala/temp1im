-- Business roles referenced by approval steps, plus all their parents
WITH refs AS (
    SELECT DISTINCT o.UID_Org
    FROM PWODecisionStep s
    JOIN Org o ON o.XObjectKey = s.ObjectKeyOfAssignedOrg
),
tree AS (
    SELECT o.UID_Org, o.UID_ParentOrg, o.Ident_Org, o.FullPath, o.UID_OrgRoot, 0 AS Lvl
    FROM Org o JOIN refs r ON r.UID_Org = o.UID_Org
    UNION ALL
    SELECT p.UID_Org, p.UID_ParentOrg, p.Ident_Org, p.FullPath, p.UID_OrgRoot, t.Lvl + 1
    FROM Org p JOIN tree t ON p.UID_Org = t.UID_ParentOrg
)
SELECT DISTINCT UID_Org, Ident_Org, FullPath, UID_OrgRoot, UID_ParentOrg
FROM tree
ORDER BY FullPath;

-- Ready-made filter for the custom transport (Org table)
SELECT 'UID_Org IN (' + STRING_AGG('''' + UID_Org + '''', ',') + ')' AS OrgFilter
FROM (SELECT DISTINCT o.UID_Org
      FROM PWODecisionStep s JOIN Org o ON o.XObjectKey = s.ObjectKeyOfAssignedOrg) x;




