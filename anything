DECLARE @ev TABLE (UID varchar(38) PRIMARY KEY);
INSERT @ev SELECT UID_QBMEvent FROM QBMEvent
WHERE EventName IN ('CCC_CONSISTENCY_CHECK_AdaptiveShield_ENTITLEMENTS','CCC_CONSISTENCY_CHECK_AdaptiveShield_USERS',
                    'CCC_CONSISTENCY_CHECK_Starling-Dev_ENTITLEMENTS','CCC_CONSISTENCY_CHECK_Starling-Dev_USERS',
                    'CCC_IT_SHOP_BULK_LOAD');

-- 1) Every FK reference to QBMEvent, generated dynamically from QBMRelation
DECLARE @sql nvarchar(max) = N'';
SELECT @sql += CONCAT(N'SELECT ''', ct.TableName, N''' AS RefTable, ''', r.RelationID, N''' AS RuleID, ',
       N'c.', cc.ColumnName, N' AS UID_QBMEvent, c.XObjectKey, c.XMarkedForDeletion, c.XUserInserted, c.XDateInserted ',
       N'FROM ', ct.TableName, N' c JOIN #ev x ON x.UID = c.', cc.ColumnName, N' UNION ALL ')
FROM QBMRelation r
JOIN DialogColumn pc ON pc.UID_DialogColumn = r.UID_ParentColumn
JOIN DialogTable  pt ON pt.UID_DialogTable  = pc.UID_DialogTable
JOIN DialogColumn cc ON cc.UID_DialogColumn = r.UID_ChildColumn
JOIN DialogTable  ct ON ct.UID_DialogTable  = cc.UID_DialogTable
WHERE pt.TableName = 'QBMEvent' AND OBJECT_ID(ct.TableName) IS NOT NULL;
SELECT * INTO #ev FROM @ev;
SET @sql = LEFT(@sql, LEN(@sql) - 10);
EXEC (@sql);

-- 2) Process plans in detail (most likely blocker), including hidden/marked ones
SELECT a.UID_JobAutoStart, a.Name, a.XMarkedForDeletion, s.Name AS ScheduleName, e.EventName
FROM JobAutoStart a
JOIN #ev x ON x.UID = a.UID_QBMEvent
JOIN QBMEvent e ON e.UID_QBMEvent = a.UID_QBMEvent
LEFT JOIN DialogSchedule s ON s.UID_DialogSchedule = a.UID_DialogSchedule;

DROP TABLE #ev;
