UPDATE JobQueue
SET Ready2EXE = 'DELETE', XDateUpdated = GETUTCDATE(), XUserUpdated = 'manual'
WHERE Queue = 'QBM_PWorkMaintenance' AND Ready2EXE = 'TRUE'
  AND ParamIN LIKE '%sp_updatestats%';


SELECT name, SUSER_SNAME(owner_sid) AS OwnerLogin, owner_sid
FROM sys.databases WHERE name = DB_NAME();

EXECUTE AS USER = 'dbo';
SELECT USER_NAME() AS DbUser, IS_MEMBER('db_owner') AS IsDbOwner,
       IS_SRVROLEMEMBER('sysadmin') AS IsSysadmin;
REVERT;

SELECT SUBSTRING(OBJECT_DEFINITION(OBJECT_ID('sys.sp_updatestats')), 1, 1500) AS CheckCode;
