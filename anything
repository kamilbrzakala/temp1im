SELECT DB_NAME() AS db, r.Ident_AERole, r.FullPath, r.UID_AERole,
       p.FullPath AS ParentPath, r.UID_ParentAERole, r.UID_AERoleManager, r.XUserInserted, r.XDateInserted
FROM AERole r
LEFT JOIN AERole p ON p.UID_AERole = r.UID_ParentAERole
WHERE r.Ident_AERole IN (N'Escalation Approvers', N'Attestation Remediation', N'Employee Administrator', N'Non Person Approvers')
ORDER BY r.FullPath;
