SELECT OBJECT_NAME(object_id) AS Proc_, last_execution_time, execution_count
FROM sys.dm_exec_procedure_stats
WHERE database_id = DB_ID() AND OBJECT_NAME(object_id) LIKE 'QBM_PWork%'
ORDER BY last_execution_time DESC;

SELECT COUNT(*) AS Waiting FROM JobQueue WHERE Queue = 'QBM_PWorkMaintenance' AND Ready2EXE = 'TRUE';


