-- the events themselves: which table, who created them
SELECT e.UID_QBMEvent, e.EventName, t.TableName, e.XUserInserted, e.XDateInserted
FROM QBMEvent e JOIN @ev x ON x.UID = e.UID_QBMEvent
LEFT JOIN DialogTable t ON t.UID_DialogTable = e.UID_DialogTable;

-- blocker 1: process plans (QBM_113)
SELECT a.UID_JobAutoStart, a.Name, a.UID_QBMEvent, a.XUserInserted
FROM JobAutoStart a JOIN @ev x ON x.UID = a.UID_QBMEvent;

-- blocker 2: processes attached to the events
SELECT g.UID_JobEventGen, jc.Name AS ProcessName, g.UID_QBMEvent, g.XUserInserted
FROM JobEventGen g JOIN @ev x ON x.UID = g.UID_QBMEvent
LEFT JOIN JobChain jc ON jc.UID_JobChain = g.UID_JobChain;

