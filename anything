SELECT d.owner_sid                 AS ServerSideOwnerSid,
       SUSER_SNAME(d.owner_sid)    AS ServerSideOwner,
       p.sid                       AS DboSidInDatabase,
       SUSER_SNAME(p.sid)          AS DboMapsToLogin,
       CASE WHEN d.owner_sid = p.sid THEN 'MATCH' ELSE 'MISMATCH' END AS Result
FROM sys.databases d
CROSS JOIN sys.database_principals p
WHERE d.name = DB_NAME() AND p.name = 'dbo';


ALTER AUTHORIZATION ON DATABASE::D1IM TO [sa];   -- or a dedicated service/owner login
