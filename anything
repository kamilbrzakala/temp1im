-- 4) Kontrola po naprawie (po kilku minutach): poziomy 49000-54000 powinny zejsc do 0
SELECT m.UID_Task, m.PathLength, m.CountInDBQueue, m.CountProcessing, m.CountResetted
FROM QBMDBQueueTaskMetric m
WHERE m.CountInDBQueue + m.CountProcessing > 0 ORDER BY m.PathLength;
SELECT * FROM QBMDBQueueCurrent WHERE UID_Task = 'QBM-K-CommonDashboardDef';

