SELECT q.UID_Job, q.StartAt,
       SQLStmt = (SELECT TOP 1 x.ParameterValue FROM dbo.QBM_FCVJobParameterToList(q.ParamIN) x WHERE x.ParameterName = 'SQLStmt')
FROM JobQueue q
WHERE q.Queue = 'QBM_PWorkMaintenance' AND q.IsRootJob = 1 AND q.Ready2EXE = 'TRUE'
ORDER BY q.StartAt;


SET LOCK_TIMEOUT 30000;
DECLARE @uid varchar(38), @cmd nvarchar(max);
DECLARE c CURSOR LOCAL FAST_FORWARD FOR
  SELECT q.UID_Job,
         (SELECT TOP 1 x.ParameterValue FROM dbo.QBM_FCVJobParameterToList(q.ParamIN) x WHERE x.ParameterName = 'SQLStmt')
  FROM JobQueue q
  WHERE q.Queue = 'QBM_PWorkMaintenance' AND q.IsRootJob = 1 AND q.Ready2EXE = 'TRUE'
    AND q.ComponentClass = 'VI.JobService.JobComponents.SQLComponent' AND q.TaskName = 'Execute SQL'
  ORDER BY q.StartAt;
OPEN c; FETCH NEXT FROM c INTO @uid, @cmd;
WHILE @@FETCH_STATUS = 0
BEGIN
  BEGIN TRY
    EXEC sp_executesql @cmd;
    UPDATE JobQueue SET Ready2EXE = 'DELETE', XDateUpdated = GETUTCDATE(), XUserUpdated = 'manual' WHERE UID_Job = @uid;
    PRINT CONCAT('OK      ', @cmd);
  END TRY
  BEGIN CATCH
    PRINT CONCAT('FAILED  ', @cmd, ' -> ', ERROR_NUMBER(), ' ', ERROR_MESSAGE());
  END CATCH
  FETCH NEXT FROM c INTO @uid, @cmd;
END
CLOSE c; DEALLOCATE c;
SET LOCK_TIMEOUT -1;

SELECT COUNT(*) AS Waiting FROM JobQueue WHERE Queue = 'QBM_PWorkMaintenance' AND Ready2EXE = 'TRUE';



UPDATE JobQueue SET Ready2EXE = 'DELETE', XDateUpdated = GETUTCDATE(), XUserUpdated = 'manual'
WHERE UID_Job = '<UID_Job>';


SELECT COUNT(*) AS Waiting FROM JobQueue WHERE Queue = 'QBM_PWorkMaintenance' AND Ready2EXE = 'TRUE';
